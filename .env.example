# ---- Backend ----
# SQLite by default. For Postgres: postgresql+psycopg://user:pass@localhost:5432/veridata
DATABASE_URL=
# 32-byte hex master key used to wrap per-file AES-256-GCM keys and dev-mode device keys.
# Generated into backend/data/master.key on first start if empty.
MASTER_KEY_HEX=
SESSION_SECRET=
# Optional IPFS (Kubo) HTTP API for pinning encrypted blobs, e.g. http://127.0.0.1:5001
IPFS_API_URL=

# ---- Hardware (ESP32) ----
# Stock ESP32-CAM CameraWebServer: still at http://<ip>/capture, MJPEG at http://<ip>:81/stream
CAM_CAPTURE_URL=http://172.20.10.9/capture
CAM_STREAM_URL=http://172.20.10.9:81/stream
# Veridata main-board firmware (firmware/veridata_main): /sensors /servo /pubkey /sign
DEVICE_CONTROL_URL=http://172.20.10.10

# ---- AI verification (any OpenAI-compatible endpoint; 0G TEE via broker as fallback) ----
# OpenAI / Meta / 0G Router (https://router-api.0g.ai/v1) / any OpenAI-compatible API.
# Leave empty + set WALLET_PRIVATE_KEY to auto-resolve a TEE provider via the 0G
# compute broker (needs >= 3 0G in the wallet ledger; otherwise keyword heuristics run).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---- 0G (Galileo testnet) ----
# Wallet used for 0G storage uploads (gas) and the compute broker. The legacy
# VERIFIER_PRIVATE_KEY name is still read for backwards compatibility.
WALLET_PRIVATE_KEY=
0G_RPC_URL=https://evmrpc-testnet.0g.ai
0G_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
0G_FLOW_ADDRESS=0x22E03a6A89B950F1c82ec5e74F8eCa321a105296
0G_CHAIN_ID=16602
# Auto-resolve TEE inference via the 0G broker when AI_BASE_URL is empty (needs 3+ 0G).
0G_COMPUTE_AUTO=1

# ---- Chain (Veridata.sol deployed from Remix on Ethereum Sepolia) ----
CHAIN_ID=11155111
CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VERIDATA_CONTRACT_ADDRESS=
EXPLORER_URL=https://sepolia.etherscan.io
# Must equal the constructor's uploadFee (in gwei). Default deploy: 100000000000000 wei = 100000 gwei
UPLOAD_FEE_GWEI=100000
PLATFORM_FEE_BPS=500

# ---- Whitechain Sepolia (chain 1874): gasless USDT checkout ----
# Address of VeridataPay.sol deployed from Remix on Whitechain Sepolia
WHITECHAIN_PAY_ADDRESS=
# Relayer key that pays WBT gas (defaults to WALLET_PRIVATE_KEY). Fund it at faucet.testnet.whitechain.io
# WHITECHAIN_RELAYER_KEY=
# USDT per 1 ETH of list price (dataset prices are stored in ETH): 100 => 0.002 ETH = 0.2 USDT
WHITECHAIN_USDT_PER_ETH=100
